@startuml
left to right direction
skinparam packageStyle rectangle

actor Anggota
actor Pustakawan

rectangle "SIPUSTAKA" {
    usecase "Cari Buku" as UC1
    usecase "Ajukan Peminjaman" as UC2
    usecase "Kembalikan Buku" as UC3
    usecase "Perpanjang Peminjaman" as UC4
    usecase "Bayar Denda" as UC5
    usecase "Daftar Anggota" as UC6
    usecase "Kelola Data Buku" as UC7
}

' Relasi Utama Anggota
Anggota --> UC1
Anggota --> UC2
Anggota --> UC3
Anggota --> UC4

' Relasi Extend (Arah panah: Extension -> Base Use Case)
' Bayar Denda memperluas Kembalikan Buku / Perpanjang jika terlambat
UC5 .> UC3 : <<extend>>
UC5 .> UC4 : <<extend>>

' Relasi Utama Pustakawan
Pustakawan --> UC6
Pustakawan --> UC7

@enduml